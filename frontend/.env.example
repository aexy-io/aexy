# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Billing
# Set to "true" once Stripe is fully configured to enable in-product checkout
# and the customer portal. While unset/false, paid-tier CTAs open a mailto to
# sales@aexy.io for offline billing.
NEXT_PUBLIC_STRIPE_ENABLED=false

# Internationalisation
# The time zone next-intl formats dates in, on the server and the client alike.
# Leave unset to use the default (Asia/Kolkata, matching the backend's own
# default) — an empty value would put the two sides in different zones and cause
# hydration mismatches, which is what setting it at all is for.
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
