node_modules
.next
.build
.DS_Store

# Local-only generated files — Next.js rewrites the next-env.d.ts
# reference between dev (`.next/dev/types/...`) and prod
# (`.next/types/...`) builds, and the TypeScript incremental build
# info is per-machine. Both should not be committed.
frontend/next-env.d.ts
frontend/tsconfig.tsbuildinfo

# Auto-generated merged i18n files (run npm run i18n:merge to regenerate)
frontend/messages/en.json
frontend/messages/hi.json
__pycache__
.env
celerybeat-schedule
backend-rust

/gtm
/prds
.playwright-mcp
screenshots

# Playwright artifacts (regenerated each test run)
frontend/playwright-report/
frontend/test-results/
frontend/e2e/debug-screenshot*.png
# Screenshot capture intermediates: e2e/tools/capture-marketing-shots.ts writes
# PNGs that are converted to the WebP which actually ships. The PNGs are ~3x
# the size and nothing imports them.
frontend/public/marketing/**/*.png

# Test coverage output (regenerated each test run)
.coverage
backend/.coverage
htmlcov/

# AI test transcripts (regenerated by backend/tests/ai)
backend/tests/ai/.logs/

# Python packaging artifacts (regenerated by `uv pip install -e` / build tools)
*.egg-info/
**/*.egg-info/

# uv lockfiles for sub-projects (generated by local `uv run`, not committed)
mailagent/uv.lock

# Python virtualenvs
.venv/
**/.venv/

# Local code-review notes
REVIEW_*.md
SEO_GTM_2_MONTH_PLAN.md
ux-tracker.md
reviews-ux-tracker.md
audit-in-app-docs.md
# macOS app bundle (built artifact)
aexy-mac/Aexy.app

# =============================================================================
# Local working files. Not part of the product and not release material.
# =============================================================================

# Per-run exports and comparison spreadsheets
*_round1.csv
*_update.csv
# Office lock files left behind next to an open spreadsheet
~$*

# Screen recordings
*.mov

# Verification captures belong on the pull request, not in git history.
verification-screenshots/

# Environment backups (also guarded in backend/.gitignore)
.env.bak*

# Note: personal scratch files (session notes, editor vaults, one-off
# spreadsheets) belong in .git/info/exclude or a global gitignore — this file
# is shared, and one contributor's working habits should not be in it.

# Claude Code task worktrees — local scratch, never part of a commit.
.claude/worktrees/
